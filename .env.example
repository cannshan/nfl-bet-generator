ODDS_API_KEY=paste_your_key_here

# Optional but recommended: free fallback odds source (sportsgameodds.com),
# used automatically only when The Odds API's key is rejected or its
# monthly quota runs out. Free tier, no credit card.
SPORTSGAMEODDS_API_KEY=

# Optional: enables live expert-insight web search (real per-use cost, see README)
ANTHROPIC_API_KEY=

# Required: prediction tracking / CLV storage (Supabase project's Settings ->
# API page). Run supabase_setup.sql once in that project's SQL Editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
